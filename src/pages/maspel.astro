<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mas Pel - Dashboard</title>
    <style>
        /* Memastikan iframe menutupi seluruh layar tanpa margin */
        body, html {
            margin: 0;
            padding: 0;
            height: 100%;
            overflow: hidden; /* Mencegah scroll ganda */
        }
        iframe {
            width: 100%;
            height: 100vh;
            border: none;
            display: block;
        }
    </style>
</head>
<body>
    <!-- Memanggil file dari folder public -->
    <iframe src="/dashboard.html" title="PEGASUS Command Control"></iframe>
</body>
</html>